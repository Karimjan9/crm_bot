# Telegram: enter the token issued for your bot.
BOT_TOKEN=
BOT_MODE=polling
PUBLIC_BASE_URL=https://crm.example.uz
TELEGRAM_WEBHOOK_SECRET=

# CRM: use the same API key and webhook secret in the Laravel project.
CRM_BASE_URL=https://crm.example.uz/api/v1
CRM_BOT_API_KEY=
CRM_WEBHOOK_SECRET=
CRM_TIMEOUT_SECONDS=15

# Local Redis. For Docker Compose, use redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_STATE_TTL_HOURS=24
OUTBOX_MAX_ATTEMPTS=5
DEAD_LETTER_RETENTION_DAYS=30

WORKDAY_START=09:00
WORKDAY_END=18:00
DEFAULT_TIMEZONE=Asia/Tashkent
MAX_UPLOAD_BYTES=20971520
